MATCH (v)-[:SPOUSE]->()-[:CHILD]->(w) 
MERGE (v)-[:CHILD]->(w);

MATCH (v)-[:CHILD]->(u), (v)-[:CHILD]->(w) 
WHERE u <> w 
MERGE (u)-[:SIBLING]->(w)-[:SIBLING]->(u);

MATCH (v)-[:CHILD*2]->(u), (v)-[:CHILD*2]->(w) 
WHERE u <> w 
MERGE (u)-[:COUSIN]->(w)-[:COUSIN]->(u);

